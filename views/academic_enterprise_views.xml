<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_academic_curriculum_list" model="ir.ui.view"><field name="name">academic.curriculum.list</field><field name="model">academic.curriculum</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="program_id"/><field name="version"/><field name="graduation_credits"/><field name="min_gpa"/><field name="active"/></list></field></record>
 <record id="view_academic_curriculum_form" model="ir.ui.view"><field name="name">academic.curriculum.form</field><field name="model">academic.curriculum</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="code"/><field name="program_id"/><field name="version"/></group><group><field name="effective_from"/><field name="effective_to"/><field name="graduation_credits"/><field name="min_gpa"/><field name="active"/></group></group><notebook><page string="Malla curricular"><field name="line_ids"><list editable="bottom"><field name="level"/><field name="sequence"/><field name="course_id"/><field name="requirement_type"/><field name="credits"/><field name="min_grade"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_academic_curriculum" model="ir.actions.act_window"><field name="name">Planes de estudio</field><field name="res_model">academic.curriculum</field><field name="view_mode">list,form</field></record>

 <record id="view_academic_hold_list" model="ir.ui.view"><field name="name">academic.hold.list</field><field name="model">academic.hold</field><field name="arch" type="xml"><list><field name="student_id"/><field name="name"/><field name="hold_type"/><field name="blocking"/><field name="blocks_graduation"/><field name="date_from"/><field name="date_to"/><field name="active"/></list></field></record>
 <record id="view_academic_hold_form" model="ir.ui.view"><field name="name">academic.hold.form</field><field name="model">academic.hold</field><field name="arch" type="xml"><form><sheet><group><field name="student_id"/><field name="name"/><field name="hold_type"/><field name="blocking"/><field name="blocks_graduation"/><field name="date_from"/><field name="date_to"/><field name="active"/><field name="notes"/></group></sheet><chatter/></form></field></record>
 <record id="action_academic_hold" model="ir.actions.act_window"><field name="name">Bloqueos académicos</field><field name="res_model">academic.hold</field><field name="view_mode">list,form</field></record>

 <record id="view_academic_request_list" model="ir.ui.view"><field name="name">academic.request.list</field><field name="model">academic.request</field><field name="arch" type="xml"><list><field name="name"/><field name="student_id"/><field name="request_type"/><field name="state"/><field name="responsible_id"/><field name="date_submitted"/></list></field></record>
 <record id="view_academic_request_form" model="ir.ui.view"><field name="name">academic.request.form</field><field name="model">academic.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Presentar" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state not in ('submitted','review')"/><button name="action_reject" type="object" string="Rechazar" invisible="state not in ('submitted','review')"/><button name="action_done" type="object" string="Completar" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="student_id"/><field name="service_id"/><field name="request_type"/><field name="responsible_id"/><field name="date_submitted"/></group><group><field name="service_fee" widget="monetary"/><field name="sla_days"/><field name="description"/><field name="attachment_ids" widget="many2many_binary"/><field name="resolution"/></group></sheet><chatter/></form></field></record>
 <record id="action_academic_request" model="ir.actions.act_window"><field name="name">Trámites académicos</field><field name="res_model">academic.request</field><field name="view_mode">list,form</field></record>
</odoo>
