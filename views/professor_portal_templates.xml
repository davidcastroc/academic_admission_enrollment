<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="professor_nav" name="Navegación docente">
  <div class="prof360-hero mb-4"><div><span class="badge text-bg-light mb-2">Portal Docente 360</span><h2 class="mb-1">Hola, <t t-esc="professor.partner_id.name"/></h2><p class="mb-0 opacity-75">Cursos, estudiantes, asistencia, evaluaciones, notas y seguimiento desde un solo lugar.</p></div><a href="/my/professor" class="btn btn-light">Mi panel</a></div>
</template>

<template id="portal_professor_dashboard" name="Portal Docente 360">
<t t-call="portal.portal_layout"><t t-set="title">Portal Docente 360</t><div class="container py-4 prof360"><t t-call="academic_admission_enrollment.professor_nav"/>
<div class="row g-3 mb-4">
 <div class="col-md-4"><div class="card p-3 h-100"><small class="text-muted">Secciones asignadas</small><div class="display-6 fw-bold"><t t-esc="len(sections)"/></div></div></div>
 <div class="col-md-4"><div class="card p-3 h-100"><small class="text-muted">Estudiantes activos</small><div class="display-6 fw-bold"><t t-esc="sum(s.enrolled_count for s in sections)"/></div></div></div>
 <div class="col-md-4"><div class="card p-3 h-100"><small class="text-muted">Entregas por revisar</small><div class="display-6 fw-bold"><t t-esc="len(pending_submissions)"/></div></div></div>
</div>
<h4 class="mb-3">Mis cursos y secciones</h4><div class="row g-3">
<t t-foreach="sections" t-as="s"><div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><div><small class="text-muted"><t t-esc="s.period_id.display_name"/></small><h5><t t-esc="s.course_id.code"/> · <t t-esc="s.course_id.name"/></h5></div><span class="badge text-bg-primary align-self-start"><t t-esc="s.code"/></span></div><p class="text-muted"><t t-esc="s.schedule or 'Horario por definir'"/> · <t t-esc="s.modality"/></p><div class="progress mb-2"><div class="progress-bar" t-attf-style="width: #{min((s.enrolled_count / s.capacity * 100) if s.capacity else 0, 100)}%;"></div></div><small><t t-esc="s.enrolled_count"/> estudiantes · <t t-esc="s.available_seats"/> cupos disponibles</small></div><div class="card-footer bg-white"><a t-att-href="'/my/professor/section/%s' % s.id" class="btn btn-primary">Abrir aula docente</a></div></div></div></t>
</div></div></t>
</template>

<template id="portal_professor_section" name="Aula docente">
<t t-call="portal.portal_layout"><div class="container py-4 prof360"><t t-call="academic_admission_enrollment.professor_nav"/><div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><h3><t t-esc="section.course_id.code"/> · <t t-esc="section.course_id.name"/></h3><p class="text-muted mb-0">Sección <t t-esc="section.code"/> · <t t-esc="section.period_id.display_name"/></p></div><span class="badge text-bg-dark"><t t-esc="section.gradebook_state"/></span></div>
<div class="row g-3 mb-4"><div class="col-md-3"><a class="prof360-action" t-att-href="'/my/professor/section/%s/gradebook'%section.id"><strong>📊 Libro de notas</strong><span>Evaluaciones, ponderaciones y acta</span></a></div><div class="col-md-3"><a class="prof360-action" t-att-href="'/my/professor/section/%s/attendance'%section.id"><strong>✓ Asistencia</strong><span>Control diario y observaciones</span></a></div><div class="col-md-3"><a class="prof360-action" t-att-href="'/my/professor/section/%s/assignments'%section.id"><strong>📝 Tareas</strong><span>Publicar y calificar entregas</span></a></div><div class="col-md-3"><div class="prof360-action"><strong>👥 <t t-esc="len(registrations)"/> estudiantes</strong><span>Lista oficial de clase</span></div></div></div>
<div class="card"><div class="card-header"><strong>Estudiantes</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Estudiante</th><th>Carné</th><th>Avance</th><th>Nota acumulada</th><th>Estado</th></tr></thead><tbody><t t-foreach="registrations" t-as="r"><tr><td><strong><t t-esc="r.student_id.display_name"/></strong></td><td><t t-esc="r.student_id.student_number or '-'"/></td><td><div class="progress" style="min-width:120px"><div class="progress-bar" t-attf-style="width: #{r.progress_percent or 0}%;"><t t-esc="str(round(r.progress_percent or 0)) + '%'"/></div></div></td><td><t t-esc="'%.2f'%r.final_grade"/></td><td><span class="badge text-bg-light"><t t-esc="r.state"/></span></td></tr></t></tbody></table></div></div>
</div></t></template>

<template id="portal_professor_gradebook" name="Libro de calificaciones docente">
<t t-call="portal.portal_layout"><div class="container-fluid py-4 px-lg-5 prof360"><t t-call="academic_admission_enrollment.professor_nav"/><div class="d-flex justify-content-between mb-3"><div><h3>Libro de calificaciones</h3><p class="text-muted"><t t-esc="section.display_name"/></p></div><a t-att-href="'/my/professor/section/%s'%section.id" class="btn btn-outline-secondary align-self-start">Volver al curso</a></div><div t-if="saved" class="alert alert-success">Notas guardadas correctamente.</div>
<div class="card mb-4"><div class="card-body"><h5>Nueva evaluación</h5><form t-att-action="'/my/professor/section/%s/assessment/new'%section.id" method="post" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input name="name" required="required" class="form-control" placeholder="Nombre de evaluación"/></div><div class="col-md-2"><select name="assessment_type" class="form-select"><option value="exam">Examen</option><option value="quiz">Prueba corta</option><option value="assignment">Tarea</option><option value="project">Proyecto</option><option value="participation">Participación</option></select></div><div class="col-md-2"><input name="weight" type="number" step="0.01" min="0" max="100" required="required" class="form-control" placeholder="Peso %"/></div><div class="col-md-2"><input name="max_score" type="number" step="0.01" value="100" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Agregar</button></div></form></div></div>
<form t-att-action="'/my/professor/section/%s/gradebook'%section.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="card"><div class="table-responsive"><table class="table table-bordered align-middle mb-0 prof360-gradebook"><thead><tr><th class="sticky-col">Estudiante</th><t t-foreach="assessments" t-as="a"><th><t t-esc="a.name"/><br/><small><t t-esc="a.weight"/>% · /<t t-esc="a.max_score"/></small></th></t><th>Acumulado</th></tr></thead><tbody><t t-foreach="registrations" t-as="r"><tr><td class="sticky-col"><strong><t t-esc="r.student_id.display_name"/></strong><br/><small><t t-esc="r.student_id.student_number or ''"/></small></td><t t-foreach="assessments" t-as="a"><t t-set="g" t-value="grade_map.get((a.id,r.id))"/><td><input t-att-name="'score_%s_%s'%(a.id,r.id)" type="number" step="0.01" min="0" t-att-max="a.max_score" t-att-value="g.score if g else ''" class="form-control form-control-sm" t-att-disabled="section.gradebook_state == 'closed' and 'disabled' or None"/><small t-if="g and g.state=='published'" class="text-success">Publicada</small></td></t><td><strong><t t-esc="'%.2f'%r.final_grade"/></strong></td></tr></t></tbody></table></div><div class="card-footer d-flex flex-wrap gap-2"><button t-if="section.gradebook_state != 'closed'" class="btn btn-primary">Guardar notas</button></div></div></form>
<div class="d-flex gap-2 mt-3"><form t-att-action="'/my/professor/section/%s/grades/publish'%section.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-success">Publicar notas a estudiantes</button></form><form t-if="section.gradebook_state != 'closed'" t-att-action="'/my/professor/section/%s/gradebook/submit'%section.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-dark">Enviar acta a revisión</button></form></div>
</div></t></template>

<template id="portal_professor_attendance" name="Asistencia docente"><t t-call="portal.portal_layout"><div class="container py-4 prof360"><t t-call="academic_admission_enrollment.professor_nav"/><h3>Asistencia · <t t-esc="section.course_id.name"/></h3><div t-if="saved" class="alert alert-success">Asistencia guardada.</div><form method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="mb-3"><label>Fecha</label><input type="date" name="date" t-att-value="date" class="form-control" style="max-width:220px"/></div><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Estudiante</th><th>Estado</th><th>Observación</th></tr></thead><tbody><t t-foreach="registrations" t-as="r"><t t-set="a" t-value="attendance_map.get(r.id)"/><tr><td><strong><t t-esc="r.student_id.display_name"/></strong></td><td><select t-att-name="'status_%s'%r.id" class="form-select"><t t-foreach="[('present','Presente'),('late','Tardía'),('absent','Ausente'),('excused','Justificada')]" t-as="op"><option t-att-value="op[0]" t-att-selected="(a.status if a else 'present') == op[0]"><t t-esc="op[1]"/></option></t></select></td><td><input t-att-name="'note_%s'%r.id" t-att-value="a.note if a else ''" class="form-control"/></td></tr></t></tbody></table></div><div class="card-footer"><button class="btn btn-primary">Guardar asistencia</button></div></div></form></div></t></template>

<template id="portal_professor_assignments" name="Tareas docente"><t t-call="portal.portal_layout"><div class="container py-4 prof360"><t t-call="academic_admission_enrollment.professor_nav"/><h3>Tareas y entregas · <t t-esc="section.course_id.name"/></h3><div class="card mb-4"><div class="card-body"><h5>Nueva tarea</h5><form method="post" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input name="name" required="required" class="form-control" placeholder="Título"/></div><div class="col-md-3"><input name="due_date" type="datetime-local" required="required" class="form-control"/></div><div class="col-md-2"><input name="max_score" type="number" value="100" class="form-control"/></div><div class="col-md-2 form-check pt-2"><input name="published" type="checkbox" class="form-check-input"/><label class="form-check-label">Publicar</label></div><div class="col-md-1"><button class="btn btn-primary">Crear</button></div><div class="col-12"><textarea name="instructions" class="form-control" placeholder="Instrucciones"></textarea></div></form></div></div><t t-foreach="assignments" t-as="a"><div class="card mb-3"><div class="card-header d-flex justify-content-between"><strong><t t-esc="a.name"/></strong><span><t t-esc="len(a.submission_ids)"/> entregas</span></div><div class="card-body"><p t-esc="a.instructions"/><t t-foreach="a.submission_ids" t-as="sub"><form t-att-action="'/my/professor/submission/%s/grade'%sub.id" method="post" class="row g-2 border-top py-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><strong><t t-esc="sub.student_id.display_name"/></strong><br/><small><t t-esc="sub.state"/></small></div><div class="col-md-2"><input name="score" type="number" step="0.01" min="0" t-att-max="a.max_score" t-att-value="sub.score" class="form-control"/></div><div class="col-md-4"><input name="feedback" t-att-value="sub.feedback or ''" class="form-control" placeholder="Retroalimentación"/></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Calificar</button></div></form></t></div></div></t></div></t></template>
</odoo>
