<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_document_type_list" model="ir.ui.view"><field name="name">academic.document.type.list</field><field name="model">academic.document.type</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="validity_required"/><field name="active"/></list></field></record>
    <record id="view_academic_document_type_form" model="ir.ui.view"><field name="name">academic.document.type.form</field><field name="model">academic.document.type</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="sequence"/><field name="validity_required"/><field name="ai_classification_hint"/><field name="active"/></group><field name="description"/></sheet></form></field></record>
    <record id="action_academic_document_type" model="ir.actions.act_window"><field name="name">Document Types</field><field name="res_model">academic.document.type</field><field name="view_mode">list,form</field></record>

    <record id="view_academic_document_requirement_list" model="ir.ui.view"><field name="name">academic.document.requirement.list</field><field name="model">academic.document.requirement</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="document_type_id"/><field name="program_id"/><field name="offering_id"/><field name="required"/><field name="active"/><field name="notes"/></list></field></record>
    <record id="action_academic_document_requirement" model="ir.actions.act_window"><field name="name">Document Requirements</field><field name="res_model">academic.document.requirement</field><field name="view_mode">list,form</field></record>

    <record id="view_academic_application_document_list" model="ir.ui.view"><field name="name">academic.application.document.list</field><field name="model">academic.application.document</field><field name="arch" type="xml"><list><field name="application_id"/><field name="document_type_id"/><field name="filename"/><field name="state"/><field name="expiry_date"/><field name="ocr_confidence"/><field name="reviewer_id"/></list></field></record>
    <record id="view_academic_application_document_form" model="ir.ui.view"><field name="name">academic.application.document.form</field><field name="model">academic.application.document</field><field name="arch" type="xml"><form><header><button name="action_queue_ocr" type="object" string="Queue OCR/AI" class="btn-secondary" invisible="state not in ['pending','error']"/><button name="action_run_ocr" type="object" string="Run OCR/AI" class="btn-secondary" invisible="state not in ['queued','pending','error']"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'approved'"/><button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state == 'rejected'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="application_id"/><field name="document_type_id"/><field name="attachment_id"/><field name="filename" readonly="1"/><field name="mimetype" readonly="1"/></group><group><field name="expiry_date"/><field name="is_expired" readonly="1"/><field name="reviewer_id" readonly="1"/><field name="reviewed_at" readonly="1"/></group></group><group string="Review"><field name="review_note"/><field name="detected_document_type" readonly="1"/><field name="ocr_confidence" readonly="1"/><field name="ocr_result" readonly="1"/></group></sheet><chatter/></form></field></record>
    <record id="action_academic_application_document" model="ir.actions.act_window"><field name="name">Application Documents</field><field name="res_model">academic.application.document</field><field name="view_mode">list,form</field></record>
</odoo>
