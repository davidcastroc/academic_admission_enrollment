<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_application_search" model="ir.ui.view">
        <field name="name">academic.application.search</field>
        <field name="model">academic.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="applicant_name"/><field name="identification"/><field name="partner_id"/><field name="offering_id"/><field name="state"/>
                <filter string="Requiere corrección" name="needs_attention" domain="[('state', '=', 'correction')]"/>
                <filter string="Aprobada" name="approved" domain="[('state', 'in', ['approved','enrolled'])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Oferta académica" name="group_offering" context="{'group_by':'offering_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_academic_application_list" model="ir.ui.view">
        <field name="name">academic.application.list</field>
        <field name="model">academic.application</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ['approved','enrolled']" decoration-danger="state == 'rejected'" decoration-warning="state == 'correction'">
                <field name="name"/><field name="applicant_name"/><field name="identification"/><field name="offering_id"/><field name="state"/><field name="missing_required_documents"/><field name="invalid_documents"/><field name="crm_lead_id"/><field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_academic_application_form" model="ir.ui.view">
        <field name="name">academic.application.form</field>
        <field name="model">academic.application</field>
        <field name="arch" type="xml">
            <form string="Solicitud académica">
                <header>
                    <button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state not in ['draft','correction']" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_send_admin_review" type="object" string="Revisión administrativa" class="btn-secondary" invisible="state not in ['auto_review','submitted']" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_send_academic_review" type="object" string="Revisión académica" class="btn-primary" invisible="state != 'admin_review'" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_request_correction" type="object" string="Solicitar corrección" class="btn-secondary" invisible="state not in ['auto_review','admin_review','academic_review']" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'academic_review'" groups="academic_admission_enrollment.group_academic_direction"/>
                    <button name="action_reject" type="object" string="Rechazar" class="btn-secondary" invisible="state not in ['admin_review','academic_review']" groups="academic_admission_enrollment.group_academic_direction"/>
                    <button name="action_create_student" type="object" string="Crear estudiante" invisible="state not in ['approved','enrolled'] or student_id" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_enroll" type="object" string="Matricular" class="btn-primary" invisible="state != 'approved'" groups="academic_admission_enrollment.group_academic_admissions"/>
                    <button name="action_check_conesup" type="object" string="Consultar CONESUP" class="btn-secondary" invisible="state in ['draft','cancelled']" groups="academic_admission_enrollment.group_academic_direction"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ['cancelled','enrolled']" groups="academic_admission_enrollment.group_academic_manager"/>
                    <button name="action_reset_draft" type="object" string="Restablecer a borrador" invisible="state == 'draft'" groups="academic_admission_enrollment.group_academic_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,auto_review,admin_review,academic_review,correction,approved,enrolled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(action_academic_application_document)d" icon="fa-file" context="{'search_default_application_id': id}" invisible="not id">
                            <field name="missing_required_documents" widget="statinfo" string="Documentos faltantes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Correction Required" bg_color="text-bg-warning" invisible="state != 'correction'"/>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Solicitante">
                            <field name="partner_id"/>
                            <field name="applicant_name"/>
                            <field name="identification_type"/>
                            <field name="identification"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="requires_guarantor" readonly="1"/>
                        </group>
                        <group string="Solicitud">
                            <field name="offering_id"/>
                            <field name="crm_lead_id" readonly="1"/>
                            <field name="student_id" readonly="1"/>
                            <field name="enrollment_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="all_documents_ready" readonly="1"/>
                            <field name="invalid_documents" readonly="1"/>
                        </group>
                    </group>
                    <group string="Contacto y dirección">
                        <group><field name="email"/><field name="phone"/><field name="country_id"/><field name="state_id"/></group>
                        <group><field name="canton"/><field name="district"/><field name="street"/></group>
                    </group>
                    <notebook>
                        <page string="Documentos">
                            <field name="document_ids" context="{'default_application_id': id}">
                                <list editable="bottom"><field name="document_type_id"/><field name="attachment_id"/><field name="state"/><field name="expiry_date"/><field name="is_expired"/><field name="ocr_confidence"/><field name="review_note"/></list>
                            </field>
                        </page>
                        <page string="Fiador / Responsable" invisible="not requires_guarantor and not guarantor_ids">
                            <field name="guarantor_ids" context="{'default_application_id': id}">
                                <list editable="bottom"><field name="partner_id"/><field name="relationship"/><field name="identification"/><field name="phone"/><field name="email"/><field name="state"/></list>
                            </field>
                        </page>
                        <page string="Convalidaciones">
                            <field name="convalidation_ids" context="{'default_application_id': id}">
                                <list><field name="name"/><field name="state"/><field name="crm_lead_id"/><field name="create_date"/></list>
                            </field>
                        </page>
                        <page string="Decisión">
                            <group><field name="correction_note" placeholder="Explain what the applicant must correct..."/><field name="rejection_reason" placeholder="Required before rejection..."/></group>
                        </page>
                        <page string="CONESUP">
                            <group><field name="conesup_status" readonly="1"/><field name="conesup_message" readonly="1"/></group>
                        </page>
                        <page string="Auditoría">
                            <field name="event_ids" readonly="1"><list create="0" delete="0"><field name="event_date"/><field name="user_id"/><field name="code"/><field name="description"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_academic_application" model="ir.actions.act_window">
        <field name="name">Applications</field><field name="res_model">academic.application</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_academic_application_search"/>
    </record>
</odoo>
