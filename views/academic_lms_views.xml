<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_academic_course_list" model="ir.ui.view"><field name="name">academic.course.list</field><field name="model">academic.course</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="program_id"/><field name="credits"/><field name="hours"/><field name="active"/></list></field></record>
  <record id="view_academic_course_form" model="ir.ui.view"><field name="name">academic.course.form</field><field name="model">academic.course</field><field name="arch" type="xml"><form string="Curso"><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="program_id"/><field name="credits"/><field name="hours"/></group><group><field name="prerequisite_ids" widget="many2many_tags"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Descripción"><field name="description"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_academic_course" model="ir.actions.act_window"><field name="name">Cursos</field><field name="res_model">academic.course</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_professor_list" model="ir.ui.view"><field name="name">academic.professor.list</field><field name="model">academic.professor</field><field name="arch" type="xml"><list><field name="employee_code"/><field name="partner_id"/><field name="user_id"/><field name="title"/><field name="active"/></list></field></record>
  <record id="view_academic_professor_form" model="ir.ui.view"><field name="name">academic.professor.form</field><field name="model">academic.professor</field><field name="arch" type="xml"><form string="Profesor"><sheet><group><group><field name="partner_id"/><field name="user_id"/><field name="employee_code"/></group><group><field name="title"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Secciones"><field name="section_ids"/></page><page string="Biografía"><field name="biography"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_academic_professor" model="ir.actions.act_window"><field name="name">Profesores</field><field name="res_model">academic.professor</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_section_list" model="ir.ui.view"><field name="name">academic.section.list</field><field name="model">academic.section</field><field name="arch" type="xml"><list decoration-success="state == 'open'"><field name="course_id"/><field name="code"/><field name="period_id"/><field name="professor_ids" widget="many2many_tags"/><field name="schedule"/><field name="enrolled_count"/><field name="available_seats"/><field name="state"/></list></field></record>
  <record id="view_academic_section_form" model="ir.ui.view"><field name="name">academic.section.form</field><field name="model">academic.section</field><field name="arch" type="xml"><form string="Sección"><header><button name="action_open" string="Abrir matrícula" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" string="Cerrar" type="object" invisible="state != 'open'"/><button name="action_finish" string="Finalizar" type="object" invisible="state not in ('open','closed')"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="course_id"/><field name="code"/><field name="period_id"/><field name="professor_ids" widget="many2many_tags"/></group><group><field name="modality"/><field name="campus"/><field name="room"/><field name="schedule"/><field name="capacity"/><field name="available_seats" readonly="1"/></group></group><notebook><page string="Estudiantes"><field name="registration_ids"><list editable="bottom"><field name="student_id"/><field name="state"/><field name="final_grade" readonly="1"/><field name="passed" readonly="1"/></list></field></page><page string="Evaluaciones"><field name="assessment_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="assessment_type"/><field name="date"/><field name="max_score"/><field name="weight"/><field name="published"/></list></field></page><page string="Tareas"><field name="assignment_ids"/></page><page string="Anuncios"><field name="announcement_ids"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_academic_section" model="ir.actions.act_window"><field name="name">Secciones</field><field name="res_model">academic.section</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_registration_list" model="ir.ui.view"><field name="name">academic.registration.list</field><field name="model">academic.course.registration</field><field name="arch" type="xml"><list><field name="student_id"/><field name="course_id"/><field name="section_id"/><field name="period_id"/><field name="state"/><field name="final_grade"/><field name="passed"/></list></field></record>
  <record id="view_academic_registration_form" model="ir.ui.view"><field name="name">academic.registration.form</field><field name="model">academic.course.registration</field><field name="arch" type="xml"><form><header><button name="action_enroll" string="Confirmar matrícula" type="object" class="btn-primary" invisible="state not in ('requested','waitlist')"/><button name="action_withdraw" string="Retirar" type="object" invisible="state not in ('requested','enrolled','waitlist')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="student_id"/><field name="section_id"/><field name="final_grade" readonly="1"/><field name="passed" readonly="1"/></group><notebook><page string="Calificaciones"><field name="grade_ids"><list editable="bottom"><field name="assessment_id"/><field name="score"/><field name="percentage" readonly="1"/><field name="state"/></list></field></page><page string="Asistencia"><field name="attendance_ids"><list editable="bottom"><field name="date"/><field name="status"/><field name="note"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_academic_registration" model="ir.actions.act_window"><field name="name">Matrícula por cursos</field><field name="res_model">academic.course.registration</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_grade_list" model="ir.ui.view"><field name="name">academic.grade.list</field><field name="model">academic.grade</field><field name="arch" type="xml"><list editable="bottom"><field name="section_id"/><field name="student_id"/><field name="assessment_id"/><field name="score"/><field name="percentage" readonly="1"/><field name="state"/></list></field></record>
  <record id="view_academic_grade_form" model="ir.ui.view"><field name="name">academic.grade.form</field><field name="model">academic.grade</field><field name="arch" type="xml"><form><header><button name="action_publish" string="Publicar nota" type="object" class="btn-primary" invisible="state == 'published'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="registration_id"/><field name="assessment_id"/><field name="score"/><field name="percentage" readonly="1"/></group><field name="feedback"/></sheet><chatter/></form></field></record>
  <record id="action_academic_grade" model="ir.actions.act_window"><field name="name">Libro de calificaciones</field><field name="res_model">academic.grade</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_attendance_list" model="ir.ui.view"><field name="name">academic.attendance.list</field><field name="model">academic.attendance</field><field name="arch" type="xml"><list editable="bottom"><field name="date"/><field name="section_id"/><field name="student_id"/><field name="status"/><field name="note"/></list></field></record>
  <record id="action_academic_attendance" model="ir.actions.act_window"><field name="name">Asistencia</field><field name="res_model">academic.attendance</field><field name="view_mode">list</field></record>

  <record id="view_academic_assignment_list" model="ir.ui.view"><field name="name">academic.assignment.list</field><field name="model">academic.assignment</field><field name="arch" type="xml"><list><field name="name"/><field name="section_id"/><field name="due_date"/><field name="max_score"/><field name="published"/></list></field></record>
  <record id="view_academic_assignment_form" model="ir.ui.view"><field name="name">academic.assignment.form</field><field name="model">academic.assignment</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="section_id"/><field name="due_date"/><field name="max_score"/><field name="published"/></group><field name="instructions"/><notebook><page string="Entregas"><field name="submission_ids"><list><field name="student_id"/><field name="submitted_at"/><field name="state"/><field name="score"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_academic_assignment" model="ir.actions.act_window"><field name="name">Tareas</field><field name="res_model">academic.assignment</field><field name="view_mode">list,form</field></record>

  <record id="view_academic_integration_list" model="ir.ui.view"><field name="name">academic.integration.list</field><field name="model">academic.integration.connector</field><field name="arch" type="xml"><list><field name="name"/><field name="provider"/><field name="base_url"/><field name="state"/><field name="last_sync"/><field name="active"/></list></field></record>
  <record id="view_academic_integration_form" model="ir.ui.view"><field name="name">academic.integration.form</field><field name="model">academic.integration.connector</field><field name="arch" type="xml"><form><header><button name="action_mark_ready" string="Validar configuración" type="object" class="btn-primary"/><button name="action_sync" string="Sincronizar ahora" type="object" invisible="state != 'ready'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="provider"/><field name="base_url"/></group><group><field name="client_id"/><field name="secret" password="True"/><field name="last_sync" readonly="1"/></group></group><group string="Alcance"><field name="sync_students"/><field name="sync_courses"/><field name="sync_grades"/><field name="sync_assignments"/></group></sheet><chatter/></form></field></record>
  <record id="action_academic_integration" model="ir.actions.act_window"><field name="name">Integraciones educativas</field><field name="res_model">academic.integration.connector</field><field name="view_mode">list,form</field></record>
</odoo>
