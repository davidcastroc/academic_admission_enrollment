<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_academic_fee_rule_list" model="ir.ui.view"><field name="name">academic.fee.rule.list</field><field name="model">academic.fee.rule</field><field name="arch" type="xml"><list><field name="sequence"/><field name="code"/><field name="name"/><field name="charge_type"/><field name="program_id"/><field name="amount"/><field name="currency_id"/><field name="active"/></list></field></record>
 <record id="view_academic_fee_rule_form" model="ir.ui.view"><field name="name">academic.fee.rule.form</field><field name="model">academic.fee.rule</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="charge_type"/><field name="program_id"/><field name="product_id"/><field name="amount"/><field name="currency_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
 <record id="action_academic_fee_rule" model="ir.actions.act_window"><field name="name">Aranceles</field><field name="res_model">academic.fee.rule</field><field name="view_mode">list,form</field></record>

 <record id="view_academic_charge_list" model="ir.ui.view"><field name="name">academic.charge.list</field><field name="model">academic.charge</field><field name="arch" type="xml"><list decoration-danger="due_date &lt; context_today() and balance &gt; 0"><field name="name"/><field name="student_id"/><field name="period_id"/><field name="description"/><field name="due_date"/><field name="net_amount"/><field name="paid_amount"/><field name="balance"/><field name="currency_id"/><field name="state"/></list></field></record>
 <record id="view_academic_charge_form" model="ir.ui.view"><field name="name">academic.charge.form</field><field name="model">academic.charge</field><field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Facturar / Confirmar" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Anular" invisible="state in ('paid','cancelled')"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="student_id"/><field name="period_id"/><field name="fee_rule_id"/><field name="description"/></group><group><field name="charge_date"/><field name="due_date"/><field name="amount"/><field name="discount_amount"/><field name="net_amount"/><field name="paid_amount"/><field name="balance"/><field name="currency_id"/></group></group><field name="invoice_id"/></sheet><chatter/></form></field></record>
 <record id="action_academic_charge" model="ir.actions.act_window"><field name="name">Estado de cuenta / Cargos</field><field name="res_model">academic.charge</field><field name="view_mode">list,form</field></record>

 <record id="view_academic_scholarship_list" model="ir.ui.view"><field name="name">academic.scholarship.list</field><field name="model">academic.scholarship</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="discount_type"/><field name="value"/><field name="active"/></list></field></record>
 <record id="view_academic_scholarship_form" model="ir.ui.view"><field name="name">academic.scholarship.form</field><field name="model">academic.scholarship</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="discount_type"/><field name="value"/><field name="active"/></group></sheet><chatter/></form></field></record>
 <record id="action_academic_scholarship" model="ir.actions.act_window"><field name="name">Becas y beneficios</field><field name="res_model">academic.scholarship</field><field name="view_mode">list,form</field></record>

 <record id="view_academic_payment_plan_list" model="ir.ui.view"><field name="name">academic.payment.plan.list</field><field name="model">academic.payment.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="student_id"/><field name="period_id"/><field name="total_amount"/><field name="currency_id"/><field name="state"/></list></field></record>
 <record id="view_academic_payment_plan_form" model="ir.ui.view"><field name="name">academic.payment.plan.form</field><field name="model">academic.payment.plan</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="student_id"/><field name="period_id"/><field name="state"/><field name="total_amount"/><field name="currency_id"/></group><field name="line_ids"><list editable="bottom"><field name="due_date"/><field name="amount"/><field name="state"/><field name="charge_id"/></list></field></sheet><chatter/></form></field></record>
 <record id="action_academic_payment_plan" model="ir.actions.act_window"><field name="name">Planes de pago</field><field name="res_model">academic.payment.plan</field><field name="view_mode">list,form</field></record>
</odoo>
