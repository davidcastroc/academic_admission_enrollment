<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_student_list" model="ir.ui.view"><field name="name">academic.student.list</field><field name="model">academic.student</field><field name="arch" type="xml"><list><field name="code"/><field name="partner_id"/><field name="identification"/><field name="program_id"/><field name="state"/><field name="enrollment_count"/></list></field></record>
    <record id="view_academic_student_form" model="ir.ui.view"><field name="name">academic.student.form</field><field name="model">academic.student</field><field name="arch" type="xml"><form><sheet><group><group><field name="code" readonly="1"/><field name="partner_id"/><field name="identification"/><field name="program_id"/></group><group><field name="state"/><field name="admission_application_id"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Enrollments"><field name="enrollment_ids" readonly="1"><list><field name="name"/><field name="offering_id"/><field name="enrollment_date"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_academic_student" model="ir.actions.act_window"><field name="name">Students</field><field name="res_model">academic.student</field><field name="view_mode">list,form</field></record>

    <record id="view_academic_enrollment_list" model="ir.ui.view"><field name="name">academic.enrollment.list</field><field name="model">academic.enrollment</field><field name="arch" type="xml"><list><field name="name"/><field name="student_id"/><field name="offering_id"/><field name="enrollment_date"/><field name="state"/></list></field></record>
    <record id="view_academic_enrollment_form" model="ir.ui.view"><field name="name">academic.enrollment.form</field><field name="model">academic.enrollment</field><field name="arch" type="xml"><form><sheet><group><field name="name" readonly="1"/><field name="student_id"/><field name="offering_id"/><field name="application_id"/><field name="enrollment_date"/><field name="state"/></group></sheet><chatter/></form></field></record>
    <record id="action_academic_enrollment" model="ir.actions.act_window"><field name="name">Enrollments</field><field name="res_model">academic.enrollment</field><field name="view_mode">list,form</field></record>
</odoo>
