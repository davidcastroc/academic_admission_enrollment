<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_convalidation_list" model="ir.ui.view"><field name="name">academic.convalidation.list</field><field name="model">academic.convalidation</field><field name="arch" type="xml"><list><field name="name"/><field name="application_id"/><field name="partner_id"/><field name="state"/><field name="crm_lead_id"/><field name="create_date"/></list></field></record>
    <record id="view_academic_convalidation_form" model="ir.ui.view"><field name="name">academic.convalidation.form</field><field name="model">academic.convalidation</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state != 'draft'"/><button name="action_review" type="object" string="Iniciar revisión" invisible="state != 'submitted'"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'review'" groups="academic_admission_enrollment.group_academic_direction"/><button name="action_reject" type="object" string="Rechazar" invisible="state != 'review'" groups="academic_admission_enrollment.group_academic_direction"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="1"/><field name="application_id"/><field name="partner_id" readonly="1"/><field name="student_id" readonly="1"/><field name="crm_lead_id" readonly="1"/></group><field name="description"/><field name="attachment_ids" widget="many2many_binary"/><field name="decision_note"/></sheet><chatter/></form></field></record>
    <record id="action_academic_convalidation" model="ir.actions.act_window"><field name="name">Convalidations</field><field name="res_model">academic.convalidation</field><field name="view_mode">list,form</field></record>
</odoo>
