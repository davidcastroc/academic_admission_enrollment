<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_program_list" model="ir.ui.view"><field name="name">academic.program.list</field><field name="model">academic.program</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field></record>
    <record id="view_academic_program_form" model="ir.ui.view"><field name="name">academic.program.form</field><field name="model">academic.program</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><field name="description"/></sheet></form></field></record>
    <record id="action_academic_program" model="ir.actions.act_window"><field name="name">Programs</field><field name="res_model">academic.program</field><field name="view_mode">list,form</field></record>

    <record id="view_academic_period_list" model="ir.ui.view"><field name="name">academic.period.list</field><field name="model">academic.period</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="date_start"/><field name="date_end"/><field name="active"/></list></field></record>
    <record id="view_academic_period_form" model="ir.ui.view"><field name="name">academic.period.form</field><field name="model">academic.period</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="name"/><field name="active"/></group><group><field name="date_start"/><field name="date_end"/><field name="application_start"/><field name="application_end"/></group></group></sheet></form></field></record>
    <record id="action_academic_period" model="ir.actions.act_window"><field name="name">Periods</field><field name="res_model">academic.period</field><field name="view_mode">list,form</field></record>

    <record id="view_academic_offering_list" model="ir.ui.view"><field name="name">academic.offering.list</field><field name="model">academic.offering</field><field name="arch" type="xml"><list><field name="program_id"/><field name="period_id"/><field name="modality"/><field name="campus"/><field name="capacity"/><field name="application_count"/><field name="approved_count"/><field name="enrolled_count"/><field name="is_published"/></list></field></record>
    <record id="view_academic_offering_form" model="ir.ui.view"><field name="name">academic.offering.form</field><field name="model">academic.offering</field><field name="arch" type="xml"><form><sheet><widget name="web_ribbon" title="Not Published" bg_color="text-bg-warning" invisible="is_published"/><group><group><field name="program_id"/><field name="period_id"/><field name="modality"/><field name="campus"/></group><group><field name="capacity"/><field name="is_published"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Indicadores"><field name="application_count" readonly="1"/><field name="approved_count" readonly="1"/><field name="enrolled_count" readonly="1"/><field name="available_seats" readonly="1"/></group></sheet><chatter/></form></field></record>
    <record id="action_academic_offering" model="ir.actions.act_window"><field name="name">Academic Offerings</field><field name="res_model">academic.offering</field><field name="view_mode">list,form</field></record>
</odoo>
