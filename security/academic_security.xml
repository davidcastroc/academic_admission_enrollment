<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_academic" model="ir.module.category">
        <field name="name">Academic</field>
        <field name="description">Academic admissions and enrollment security</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_academic_admissions" model="res.groups">
        <field name="name">Admissions</field>
        <field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_academic_direction" model="res.groups">
        <field name="name">Direction / Academic Approval</field>
        <field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('group_academic_admissions'))]"/>
    </record>
    <record id="group_academic_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_academic_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('group_academic_direction'))]"/>
    </record>


    <record id="group_academic_professor" model="res.groups">
        <field name="name">Profesor</field><field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_academic_registrar" model="res.groups">
        <field name="name">Registro académico</field><field name="category_id" ref="module_category_academic"/>
        <field name="implied_ids" eval="[(4, ref('group_academic_admissions'))]"/>
    </record>

    <!-- Company isolation. ACLs grant the operation; these rules restrict the records. -->
    <record id="rule_academic_application_company" model="ir.rule">
        <field name="name">Academic applications by company</field>
        <field name="model_id" ref="model_academic_application"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_document_company" model="ir.rule">
        <field name="name">Academic documents by company</field>
        <field name="model_id" ref="model_academic_application_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager'))]"/>
    </record>
    <record id="rule_academic_student_company" model="ir.rule">
        <field name="name">Academic students by company</field>
        <field name="model_id" ref="model_academic_student"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_enrollment_company" model="ir.rule">
        <field name="name">Academic enrollments by company</field>
        <field name="model_id" ref="model_academic_enrollment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_offering_company" model="ir.rule">
        <field name="name">Academic offerings by company</field>
        <field name="model_id" ref="model_academic_offering"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_program_company" model="ir.rule">
        <field name="name">Academic programs by company</field>
        <field name="model_id" ref="model_academic_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_period_company" model="ir.rule">
        <field name="name">Academic periods by company</field>
        <field name="model_id" ref="model_academic_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager')), (4, ref('group_academic_cashier'))]"/>
    </record>
    <record id="rule_academic_convalidation_company" model="ir.rule">
        <field name="name">Academic convalidations by company</field>
        <field name="model_id" ref="model_academic_convalidation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_academic_admissions')), (4, ref('group_academic_direction')), (4, ref('group_academic_manager'))]"/>
    </record>

    <record id="rule_academic_section_professor_own" model="ir.rule"><field name="name">Profesor: sus secciones</field><field name="model_id" ref="model_academic_section"/><field name="domain_force">[('professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_academic_registration_professor_own" model="ir.rule"><field name="name">Profesor: estudiantes de sus secciones</field><field name="model_id" ref="model_academic_course_registration"/><field name="domain_force">[('section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_academic_assessment_professor_own" model="ir.rule"><field name="name">Profesor: evaluaciones de sus secciones</field><field name="model_id" ref="model_academic_assessment"/><field name="domain_force">[('section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_academic_grade_professor_own" model="ir.rule"><field name="name">Profesor: notas de sus secciones</field><field name="model_id" ref="model_academic_grade"/><field name="domain_force">[('section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_academic_attendance_professor_own" model="ir.rule"><field name="name">Profesor: asistencia de sus secciones</field><field name="model_id" ref="model_academic_attendance"/><field name="domain_force">[('section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_academic_assignment_professor_own" model="ir.rule"><field name="name">Profesor: tareas de sus secciones</field><field name="model_id" ref="model_academic_assignment"/><field name="domain_force">[('section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>

    <record id="rule_academic_submission_professor_own" model="ir.rule"><field name="name">Profesor: entregas de sus secciones</field><field name="model_id" ref="model_academic_assignment_submission"/><field name="domain_force">[('assignment_id.section_id.professor_ids.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>
    <record id="rule_grade_change_professor_own" model="ir.rule"><field name="name">Profesor: sus rectificaciones</field><field name="model_id" ref="model_academic_grade_change_request"/><field name="domain_force">[('professor_id.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_academic_professor'))]"/></record>

</odoo>
