<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_academic_application" model="ir.sequence">
        <field name="name">Academic Application</field>
        <field name="code">academic.application</field>
        <field name="prefix">ADM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_academic_student" model="ir.sequence">
        <field name="name">Academic Student</field>
        <field name="code">academic.student</field>
        <field name="prefix">EST/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_academic_enrollment" model="ir.sequence">
        <field name="name">Academic Enrollment</field>
        <field name="code">academic.enrollment</field>
        <field name="prefix">MAT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_academic_convalidation" model="ir.sequence">
        <field name="name">Academic Convalidation</field>
        <field name="code">academic.convalidation</field>
        <field name="prefix">CONV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
